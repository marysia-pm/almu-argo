
import numpy as np
import netCDF4
import xarray as xr

import cartopy.crs as ccrs
import cartopy
import cartopy.feature as cfeature #to z chata
from scipy.interpolate import griddata # i to

#to dodajemy żeby pozbyć się kontynentów
from cartopy.io import shapereader
from shapely.ops import unary_union
from shapely import vectorized
from shapely.geometry import Polygon

import matplotlib as mpl
import matplotlib.cm as cm
from matplotlib import pyplot as plt

import argopy
from argopy.plot import scatter_map, scatter_plot
argopy.reset_options()
argopy.clear_cache()

with argopy.set_options(parallel=True):
    f = argopy.DataFetcher(ds="bgc", params=["DOXY"])
    f = f.region([-180, 180, -90, 90]+[0, 10,'2025-05-01','2025-07-01'])
    f.load()



f

apDS = f.data

apDS

apDS.DOXY

data=apDS.argo.point2profile()
data

#Wybór danych z warstwy 0–10 m
doxy = apDS.where(apDS["PRES"] < 10)["DOXY"]

lon = doxy["LONGITUDE"].values
lat = doxy["LATITUDE"].values
oxygen = doxy.values

# Usunięcie brakujących wartości
mask = (
    np.isfinite(lon) &
    np.isfinite(lat) &
    np.isfinite(oxygen)
)

lon = lon[mask]
lat = lat[mask]
oxygen = oxygen[mask]

#tworzenie siatki
# rozdzielczość siatki
n_lon = 400
n_lat = 200

grid_lon = np.linspace(-180, 180, n_lon)
grid_lat = np.linspace(-90, 90, n_lat)

grid_lon, grid_lat = np.meshgrid(grid_lon, grid_lat)

#interpolacja danych argo na siatkę
grid_oxygen = griddata(
    (lon, lat),
    oxygen,
    (grid_lon, grid_lat),
    method="linear"
)

levels = np.arange(140, 361, 20)



#maskowanie lądu? i pobranie danych o lądach
land_shp = shapereader.natural_earth(
    resolution="110m",
    category="physical",
    name="land"
)

reader = shapereader.Reader(land_shp)
#połączenie kontynentów
land = unary_union(list(reader.geometries()))
#maska lądu
land_mask = vectorized.contains(
    land,
    grid_lon,
    grid_lat
)

#maskowanie akwenów
caspian_sea = Polygon([
    (46, 47),
    (51, 47),
    (54, 44),
    (54, 38),
    (51, 36),
    (47, 37),
    (46, 40),
    (46, 47)
])

black_sea = Polygon([
    (27, 42),
    (33, 41),
    (39, 42),
    (42, 45),
    (42, 47),
    (39, 47),
    (35, 46),
    (31, 46),
    (27, 44)
])

red_sea = Polygon([
    (32, 29),
    (35, 28),
    (39, 24),
    (43, 20),
    (43, 15),
    (40, 12),
    (38, 15),
    (37, 20),
    (35, 24),
    (32, 27)
])

excluded_seas = unary_union([
    caspian_sea,
    black_sea,
    red_sea
])
sea_mask = vectorized.contains(
    excluded_seas,
    grid_lon,
    grid_lat
)

total_mask = land_mask | sea_mask


#zamaskowanie interpolowanych wartości nad lądem
grid_oxygen_masked = np.ma.masked_where(
    total_mask,
    grid_oxygen
)

#tworzenie mapy
fig, ax = plt.subplots(
    figsize=(18, 10),
    subplot_kw={"projection": ccrs.PlateCarree()}
)

ax.set_global()

# mapa kolorów – delikatne wypełnienie obszarów
cf = ax.contourf(
    grid_lon,
    grid_lat,
    grid_oxygen_masked,
    levels=levels,
    cmap="spring_r", #tutaj kolory do izolinii
    extend="both",
    transform=ccrs.PlateCarree()
)

#izolinie
cs = ax.contour(
    grid_lon,
    grid_lat,
    grid_oxygen_masked,
    levels=levels,
    colors="black",
    linewidths=0.8,
    transform=ccrs.PlateCarree()
)

#dodanie kontynetów
ax.add_feature(
    cfeature.LAND.with_scale("110m"),
    facecolor="lightgray",
    edgecolor="black"
)

ax.coastlines()

# podpisy wartości izolinii
ax.clabel(
    cs,
    inline=True,
    fontsize=9,
    fmt="%d"
)
#Elementy mapy
ax.coastlines()
ax.add_feature(
    cfeature.LAND.with_scale("110m"),
    facecolor="lightgray",
    edgecolor="black"
)

gl = ax.gridlines(
    draw_labels=True,
    x_inline=False,
    y_inline=False
)

gl.top_labels = False
gl.right_labels = False

#kolorki
cbar = fig.colorbar(
    cf,
    ax=ax,
    orientation="horizontal",
    shrink=0.8,
    aspect=40,
    pad=0.05
)

cbar.set_label(
    "Stężenie tlenu [µmol/kg]"
)
#zapisanie
ax.set_title(
    "Stężenie tlenu rozpuszczonego (DOXY) na głębokości 0–10 m\n"
    "Dane Argo, maj–czerwiec 2023",
    fontsize=15
)

plt.savefig(
    "05-07-2023_izolinie.png",
    dpi=300,
    bbox_inches="tight"
)
fig.savefig("mapa z izoliniamii-spring.png")
plt.show()
