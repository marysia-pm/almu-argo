argopy.reset_options()
argopy.clear_cache()

#===============================================================
data_od='2020-05-01'
data_do='2020-07-01'
#===============================================================

with argopy.set_options(parallel=True):
    f = argopy.DataFetcher(ds="bgc", params=["DOXY"])
    f = f.region([-180, 180, -60, 60]+[0, 10,data_od,data_do])
    f.load()



f

apDS = f.data

apDS

apDS.DOXY

data=apDS.argo.point2profile()
data

#Wybór danych z warstwy 0–10 m
doxy = apDS.where(apDS["PRES"] < 10)["DOXY"]

lon = doxy["LONGITUDE"].values
lat = doxy["LATITUDE"].values
oxygen = doxy.values

# Usunięcie brakujących wartości
mask = (
    np.isfinite(lon) &
    np.isfinite(lat) &
    np.isfinite(oxygen)
)

lon = lon[mask]
lat = lat[mask]
oxygen = oxygen[mask]

#tworzenie siatki
# rozdzielczość siatki
n_lon = 400 #400
n_lat = 200 #200

grid_lon = np.linspace(-180, 180, n_lon)
grid_lat = np.linspace(-90, 90, n_lat)

grid_lon, grid_lat = np.meshgrid(grid_lon, grid_lat)

#interpolacja danych argo na siatkę
grid_oxygen = griddata(
    (lon, lat),
    oxygen,
    (grid_lon, grid_lat),
    method="linear"
)

levels = np.arange(130, 360, 10) #ilość izolinii chyba



#maskowanie lądu? i pobranie danych o lądach
land_shp = shapereader.natural_earth(
    resolution="110m", #tutaj zmieniłam z 110m
    category="physical",
    name="land"
)

land_reader = shapereader.Reader(land_shp)
#połączenie kontynentów
land = unary_union(list(land_reader.geometries()))

#maskowanie akwenów
marine_shp = shapereader.natural_earth(
    resolution="10m",
    category="physical",
    name="geography_marine_polys"
)

marine_reader = shapereader.Reader(marine_shp)

marine_records = list(marine_reader.records())

print("Dostępne akweny:")

for record in marine_records:
    print(record.attributes.get("name"))


wanted_seas = [
    "Black Sea",
    "Caspian Sea",
    "Red Sea"
]

selected_geometries = []

for record in marine_records:

    name = record.attributes.get("name")

    if name in wanted_seas:
        selected_geometries.append(record.geometry)

        print("Dodano do maski:", name)


excluded_seas = unary_union(
    selected_geometries
)


#maska lądu
land_mask = vectorized.contains(
    land,
    grid_lon,
    grid_lat
)

#maska mórz
sea_mask = vectorized.contains(
    excluded_seas,
    grid_lon,
    grid_lat
)

total_mask = land_mask | sea_mask

#zamaskowanie interpolowanych wartości nad lądem
grid_oxygen_masked = np.ma.masked_where(
    total_mask,
    grid_oxygen
)

#tworzenie mapy
fig, ax = plt.subplots(
    figsize=(18, 10),
    subplot_kw={"projection": ccrs.PlateCarree()}
)

ax.set_global()

# mapa kolorów – delikatne wypełnienie obszarów
cf = ax.contourf(
    grid_lon,
    grid_lat,
    grid_oxygen_masked,
    levels=levels,
    cmap="turbo", #tutaj kolory do izolinii
    extend="both",
    transform=ccrs.PlateCarree()
)

